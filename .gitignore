# --- Build outputs ---
/build/
/out/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/*.obj
**/*.exe
**/*.pdb
**/*.ilk

# --- vcpkg (vendored tool + build artifacts, not project source) ---
/third_party/vcpkg/
/vcpkg_installed/

# --- Node / frontend ---
/app/frontend/node_modules/
/app/frontend/dist/
/app/frontend/.vite/

# --- Rust / Tauri ---
/app/desktop/node_modules/
/app/desktop/src-tauri/target/
/app/desktop/src-tauri/gen/
# Cargo.lock IS committed (below the /target/ ignore) -- Gravity is a Tauri application,
# not a library, and Phase 7 asks for a reproducible release build: pinning the exact
# dependency graph a release was built and tested against is what that means in practice
# for a Rust binary (see docs/phase-7.md "Release build").

# Release-build-only staging: FFmpeg/Python/mediatool-core get copied here by
# scripts/prepare-release-resources.ps1, never committed (large, third-party, or built
# artifacts -- see app/desktop/src-tauri/resources/README.md).
/app/desktop/src-tauri/resources/*
!/app/desktop/src-tauri/resources/README.md

# --- Python ---
/python/downloader/.venv/
**/__pycache__/
*.pyc

# --- Application runtime data (never commit user data) ---
/resources/local/
# Settings and queue state fall back to a RELATIVE path when LOCALAPPDATA is unset (see
# JsonFileSettingsStore / QueuePersistence), so running the core writes one of these
# relative to whatever the current working directory was (repo root during a core-only run,
# app/desktop during a real `cargo run`/Tauri launch). Real user data, never committed.
# (Renamed from MediaTool/ to Gravity/ in Phase 7's branding pass -- see docs/phase-7.md.)
/Gravity/
**/Gravity/
*.log
settings.local.json
# Ad hoc manual downloader integration test output (docs/protocols/downloader.md) --
# real downloaded media, never committed (spec section 42).
/.manual-test-output/

# --- Local tooling state (not project source) ---
/.claude/

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store

# --- Test artifacts ---
/tests/**/fixtures/tmp/
