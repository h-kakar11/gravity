#pragma once

// Generated by CMake's configure_file() from CMakeLists.txt's `project(Gravity VERSION
// ...)` -- the single place the C++ side's version number is written (see
// docs/phase-7.md "Versioning" and scripts/check_versions.py, which cross-checks this
// against the Rust/frontend manifests). Never edit the generated core/GravityVersion.h
// directly; it is regenerated on every CMake configure.

namespace mediatool {

inline constexpr const char* kGravityVersion = "@PROJECT_VERSION@";

}  // namespace mediatool
