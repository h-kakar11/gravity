{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows (MinGW-w64, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc.exe",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows (MinGW-w64, Release)",
      "inherits": "windows-mingw-debug",
      "binaryDir": "${sourceDir}/build/windows-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitizers-debug",
      "displayName": "Sanitizers (ASan + UBSan, Debug)",
      "inherits": "windows-mingw-debug",
      "binaryDir": "${sourceDir}/build/sanitizers-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEDIATOOL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "sanitizers-linux",
      "displayName": "Sanitizers on Linux/WSL (ASan + UBSan, Debug)",
      "description": "The sanitizer build that actually runs on a stock Linux/WSL box. Deliberately does NOT inherit windows-mingw-debug: that preset pins gcc.exe/g++.exe and the x64-mingw-static vcpkg triplet, neither of which exists here, so `sanitizers-debug` cannot be configured on Linux at all despite being the documented way to run these. Dependencies come from the system (nlohmann-json, spdlog, reproc++, gtest) rather than vcpkg.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitizers-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEDIATOOL_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug"
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release"
    },
    {
      "name": "sanitizers-debug",
      "configurePreset": "sanitizers-debug"
    },
    {
      "name": "sanitizers-linux",
      "configurePreset": "sanitizers-linux"
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "integration|stress"
        }
      }
    },
    {
      "name": "windows-mingw-debug-integration",
      "configurePreset": "windows-mingw-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    },
    {
      "name": "windows-mingw-debug-stress",
      "configurePreset": "windows-mingw-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "stress"
        }
      }
    },
    {
      "name": "sanitizers-debug",
      "configurePreset": "sanitizers-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers-linux",
      "configurePreset": "sanitizers-linux",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
